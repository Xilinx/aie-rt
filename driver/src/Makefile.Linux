APP = aiengine

CC ?= gcc
AR ?= ar
CXX ?= g++
CP = cp
LIBSOURCES = $(filter-out ./liburing/%, $(wildcard ./*/*.c) $(wildcard ./*/*/*.c))
CFLAGS += -Wall -Wextra --std=c11
EXTRA_CFLAGS += -D_POSIX_C_SOURCE=200809 -D_DEFAULT_SOURCE
DOCS_DIR = ../tmp
DOXYGEN_CONFIG_FILE = ../docs/aie_driver_docs_config.dox

OUTS = $(LIBSOURCES:.c=.o)
INCLUDEFILES = ./*/xaie_clock.h ./*/xaie_reset.h ./*/xaie_core.h ./*/xaie_dma.h ./*/xaie_elfloader.h ./*/xaie_events.h ./*/xaie_events_aie.h ./*/xaie_events_aieml.h ./*/xaie_interrupt.h ./*/xaie_lite.h ./*/xaie_lite_util.h ./*/xaie_locks.h ./*/xaie_mem.h ./*/xaie_perfcnt.h ./*/xaie_plif.h ./*/xaie_ss.h ./*/xaie_timer.h ./*/xaie_trace.h ./*/xaie_util_events.h ./*/xaiegbl.h ./*/xaiegbl_defs.h ./*/xaiegbl_regdef.h ./*/xaie_io.h ./*/xaie_feature_config.h ./*/xaie_helper.h ./*/xaie_lite_hwcfg.h ./*/xaiegbl_params.h ./*/*/xlnx-ai-engine.h ./*/xaie_txn.h ./*/xaie_routing.h
INTERNALFILES = $(filter-out ./liburing/%, $(wildcard ./*/*.h ./*/*/*.h))
INCLUDEDIR = ../include
INTERNALDIR = ../internal
NAME := xaiengine
MAJOR = 4
MINOR = 0
VERSION = $(MAJOR).$(MINOR)
LIBURING_DIR ?= ./liburing
LIBURING_INCLUDE ?= ${LIBURING_DIR}/src/include
LIBURING_A ?= ${LIBURING_DIR}/src/liburing.a

.PHONY: include include_liburing doc-generate doc-clean clean

all: include lib$(NAME).so lib$(NAME).a

${LIBURING_A}:
	echo "CC=$(CC)"; \
	echo "CXX=$(CXX)"; \
	echo "CFLAGS=$(CFLAGS)"; \
	cd ${LIBURING_DIR};				\
	CC_TRIMMED=$$(echo "$(CC)" | sed 's/^[[:space:]]*//'); \
	CC_CUT_1=$$(echo "$$CC_TRIMMED" | cut -d ' ' -f 1); \
	CC_CUT_2=$$(echo "$$CC_TRIMMED" | cut -d ' ' -f 2-); \
	if [ "$$CC_CUT_1" != "$$CC_CUT_2" ]; then \
		echo "Warning: CC variable contains multiple words. Only the first word will be "; \
		echo "used to build liburing. Please ensure that CC variable is set correctly."; \
		CC_LIBURING=$$CC_CUT_1; \
		export CFLAGS="$$CFLAGS $$CC_CUT_2"; \
	else \
		CC_LIBURING=$(CC); \
		export CFLAGS="$(CFLAGS)"; \
	fi; \
	CXX_TRIMMED=$$(echo "$(CXX)" | sed 's/^[[:space:]]*//'); \
	CXX_CUT_1=$$(echo "$$CXX_TRIMMED" | cut -d ' ' -f 1); \
	CXX_CUT_2=$$(echo "$$CXX_TRIMMED" | cut -d ' ' -f 2-); \
	if [ "$$CXX_CUT_1" != "$$CXX_CUT_2" ]; then \
		echo "Warning: CXX variable contains multiple words. Only the first word will be "; \
		echo "used to build liburing. Please ensure that CXX variable is set correctly."; \
		CXX_LIBURING=$$CXX_CUT_1; \
		export CPPFLAGS="$$CPPFLAGS $$CXX_CUT_2"; \
	else \
		CXX_LIBURING=$(CXX); \
		export CPPFLAGS="$(CFLAGS)"; \
	fi; \
	echo "CC_LIBURING=$$CC_LIBURING"; \
	echo "CXX_LIBURING=$$CXX_LIBURING"; \
	echo "CFLAGS for liburing build: $$CFLAGS"; \
	echo "CPPFLAGS for liburing build: $$CPPFLAGS"; \
	./configure --cc=$${CC_LIBURING} --cxx=$${CXX_LIBURING};		\
	make -C src -j32;

include_liburing: ${LIBURING_A}
	mkdir $(INCLUDEDIR)/xaiengine -p
	mkdir $(INTERNALDIR)/xaiengine -p
	$(CP) $(LIBURING_DIR)/src/include/liburing.h $(INCLUDEDIR)/
	$(CP) $(LIBURING_DIR)/src/include/liburing $(INCLUDEDIR)/ -r
	$(CP) $(LIBURING_DIR)/src/include/liburing.h $(INTERNALDIR)/
	$(CP) $(LIBURING_DIR)/src/include/liburing $(INTERNALDIR)/ -r

include:
	mkdir $(INCLUDEDIR)/xaiengine -p
	mkdir $(INTERNALDIR)/xaiengine -p
	$(CP) xaiengine.h $(INCLUDEDIR)
	$(CP) $(INCLUDEFILES) $(INCLUDEDIR)/xaiengine
	$(CP) xaiengine.h $(INTERNALDIR)
	$(CP) $(INTERNALFILES) $(INTERNALDIR)/xaiengine

lib$(NAME).so: lib$(NAME).so.$(VERSION)
	rm -f lib$(NAME).so.$(MAJOR) lib$(NAME).so
	ln -s lib$(NAME).so.$(VERSION) lib$(NAME).so.$(MAJOR)
	ln -s lib$(NAME).so.$(MAJOR) lib$(NAME).so

ifneq (,$(or $(findstring __AIELINUX__,$(CFLAGS) $(EXTRA_CFLAGS)),$(filter linux,$(MAKECMDGOALS))))
lib$(NAME).a: ${LIBURING_A} $(OUTS)
	${AR} rcs lib${NAME}.a $(OUTS)
	(echo "OPEN lib${NAME}.a"; echo "ADDLIB ${LIBURING_A}"; echo "SAVE"; echo "END";) | ${AR} -M
	ranlib lib${NAME}.a

lib$(NAME).so.$(VERSION): ${LIBURING_A} $(OUTS)
	$(CC) $(LDFLAGS) $(OUTS) 								\
		-Wl,--whole-archive ${LIBURING_A} -Wl,--no-whole-archive			\
		-shared -Wl,-soname,lib$(NAME).so.$(MAJOR) -o lib$(NAME).so.$(VERSION)

%.o: %.c ${LIBURING_A} include include_liburing
	$(CC) $(CFLAGS) -D__AIELINUX__ -Wall -Wextra --std=c11 $(EXTRA_CFLAGS) \
		-I$(INTERNALDIR) -I$(INTERNALDIR)/xaiengine \
		-I$(LIBURING_INCLUDE) \
		-I$(INTERNALDIR)/liburing \
		-c -fPIC $< -o $@
else
lib$(NAME).a: $(OUTS)
	${AR} rcs lib${NAME}.a $^

lib$(NAME).so.$(VERSION): $(OUTS)
	$(CC) $(LDFLAGS) $^ 									\
		-shared -Wl,-soname,lib$(NAME).so.$(MAJOR) -o lib$(NAME).so.$(VERSION)

%.o: %.c include
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) -I$(INTERNALDIR) -I$(INTERNALDIR)/xaiengine 		\
		-c -fPIC $< -o $@
endif

baremetal: include lib$(NAME).so lib$(NAME).a
CFLAGS_bare += -Wall -Wextra --std=c11 -D__AIEBAREMETAL__
ifeq ($(MAKECMDGOALS) ,baremetal)
%.o: %.c include
	$(CC) $(CFLAGS_bare) -I$(INTERNALDIR) -I$(INTERNALDIR)/xaiengine -c -fPIC $< -o $@
endif

linux: include include_liburing lib$(NAME).so lib$(NAME).a

simulation: include lib$(NAME).so lib$(NAME).a
CFLAGS_simulation += -Wall -Wextra --std=c11 -D__AIESIM__ -D_DEFAULT_SOURCE
ifeq ($(MAKECMDGOALS),simulation)
%.o: %.c include
	$(CC) $(CFLAGS_simulation) -I$(INTERNALDIR) -I$(INTERNALDIR)/xaiengine -c -fPIC $< -o $@
endif

cdo: include lib$(NAME).so lib$(NAME).a
CFLAGS_cdo += -Wall -Wextra --std=c11 -D__AIECDO__
ifeq ($(MAKECMDGOALS) ,cdo)
%.o: %.c include
	$(CC) $(CFLAGS_cdo) -I$(INTERNALDIR) -I$(INTERNALDIR)/xaiengine -c -fPIC $< -o $@
endif

libmetal: include lib$(NAME).so lib$(NAME).a
CFLAGS_libmetal += -Wall -Wextra --std=c11 -D__AIEMETAL__
ifeq ($(MAKECMDGOALS), libmetal)
%.o: %.c include
	$(CC) $(CFLAGS_libmetal) -I$(INTERNALDIR) -I$(INTERNALDIR)/xaiengine -c -fPIC $< -o $@
endif

controlcode: include lib$(NAME).so lib$(NAME).a
CFLAGS_controlcode += -Wall -Wextra --std=c11 -D__AIECONTROLCODE__ -D_DEFAULT_SOURCE
ifeq ($(MAKECMDGOALS) ,controlcode)
%.o: %.c include
	$(CC) $(CFLAGS_controlcode) -I$(INTERNALDIR) -I$(INTERNALDIR)/xaiengine -c -fPIC $< -o $@
endif

doc-generate:
	mkdir -p $(DOCS_DIR)
	doxygen $(DOXYGEN_CONFIG_FILE)
	cd $(DOCS_DIR)/latex; make; cd ..

doc-clean:
	rm -rf $(DOCS_DIR)

clean:
	make -C ${LIBURING_DIR}/src clean
	rm -rf $(OUTS) *.so *.so.* ${LIBURING_A} lib$(NAME).a
	rm -rf $(INCLUDEDIR)
	rm -rf $(INTERNALDIR)
